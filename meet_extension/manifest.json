{
  "manifest_version": 3,
  "key": "",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:49321"
  },
  "name": "Sumi · Meet",
  "version": "0.5.0",
  "description": "Vincula sozinha a reunião aberta ao Sumi: toca os sons dos efeitos na chamada e fecha a aba quando você pede.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "http://127.0.0.1:49321/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sumi · Meet"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "mixer.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "heartbeat.js"
      ],
      "run_at": "document_start"
    }
  ]
}
